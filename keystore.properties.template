# Copy this file to `keystore.properties` (same directory) on the machine that holds your
# signing key, then fill in the real values. `keystore.properties`, *.jks and *.keystore are
# gitignored — NEVER commit them. This template is safe to commit.
#
# storeFile is resolved relative to the app module (app/), so a keystore sitting at the repo
# root is referenced as ../originisle-release.jks
#
# Generate the key once (keep the .jks and these passwords backed up somewhere safe — losing
# them means you can never publish a signature-compatible update again):
#
#   keytool -genkeypair -v -keystore originisle-release.jks -alias originisle \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=../originisle-release.jks
storePassword=CHANGE_ME
keyAlias=originisle
keyPassword=CHANGE_ME
